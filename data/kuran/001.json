{"no":1,"ayetler":[{"n":1,"g":1,"c":1,"s":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tr":"Rahman ve Rahim olan Allah'ın adıyla:","ok":"bismi-llâhi-rraḥmâni-rraḥîm."},{"n":2,"g":2,"c":1,"s":1,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","tr":"Hamd, Alemlerin Rabbi Allah'a mahsustur.","ok":"elḥamdü lillâhi rabbi-l`âlemîn."},{"n":3,"g":3,"c":1,"s":1,"ar":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tr":"O Rahman ve Rahim'dir,","ok":"erraḥmâni-rraḥîm."},{"n":4,"g":4,"c":1,"s":1,"ar":"مَٰلِكِ يَوْمِ ٱلدِّينِ","tr":"Din Gününün sahibidir.","ok":"mâliki yevmi-ddîn."},{"n":5,"g":5,"c":1,"s":1,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tr":"Ancak Sana kulluk eder ve yalnız Senden yardım dileriz.","ok":"iyyâke na`büdü veiyyâke neste`în."},{"n":6,"g":6,"c":1,"s":1,"ar":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","tr":"Bizi doğru yola eriştir.","ok":"ihdine-ṣṣirâṭa-lmüsteḳîm."},{"n":7,"g":7,"c":1,"s":1,"ar":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","tr":"Nimete erdirdiğin kimselerin yoluna; gazaba uğrayanların, ya da sapıtanların yoluna değil.","ok":"ṣirâṭa-lleẕîne en`amte `aleyhim gayri-lmagḍûbi `aleyhim vele-ḍḍâllîn."}]}