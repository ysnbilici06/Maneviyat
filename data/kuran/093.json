{"no":93,"ayetler":[{"n":1,"g":6080,"c":30,"s":596,"ar":"وَٱلضُّحَىٰ","tr":"Kuşluk vaktine and olsun;","ok":"veḍḍuḥâ."},{"n":2,"g":6081,"c":30,"s":596,"ar":"وَٱلَّيْلِ إِذَا سَجَىٰ","tr":"Sükun erdiği zaman geceye and olsun ki,","ok":"velleyli iẕâ secâ."},{"n":3,"g":6082,"c":30,"s":596,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","tr":"Rabbin seni ne bıraktı ve ne de sana darıldı.","ok":"mâ vedde`ake rabbüke vemâ ḳalâ."},{"n":4,"g":6083,"c":30,"s":596,"ar":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","tr":"Doğrusu ahiret senin için dünyadan daha hayırlıdır.","ok":"velel'âḫiratü ḫayrul leke mine-l'ûlâ."},{"n":5,"g":6084,"c":30,"s":596,"ar":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","tr":"Rabbin şüphesiz sana verecek ve sen de hoşnut olacaksın.","ok":"velesevfe yü`ṭîke rabbüke feterḍâ."},{"n":6,"g":6085,"c":30,"s":596,"ar":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","tr":"Seni öksüz bulup da barındırmadı mı?","ok":"elem yecidke yetîmen feâvâ."},{"n":7,"g":6086,"c":30,"s":596,"ar":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","tr":"Seni şaşırmış bulup, doğru yola eriştirmedi mi?","ok":"vevecedeke ḍâllen fehedâ."},{"n":8,"g":6087,"c":30,"s":596,"ar":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","tr":"Seni fakir bulup zenginleştirmedi mi?","ok":"vevecedeke `âilen feagnâ."},{"n":9,"g":6088,"c":30,"s":596,"ar":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","tr":"Öyleyse sakın öksüze kötü muamele etme;","ok":"feemme-lyetîme felâ taḳher."},{"n":10,"g":6089,"c":30,"s":596,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","tr":"Ve sakın bir şey isteyeni azarlama;","ok":"veemme-ssâile felâ tenher."},{"n":11,"g":6090,"c":30,"s":596,"ar":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","tr":"Yalnızca Rabbinin nimetini anlat.","ok":"veemmâ bini`meti rabbike feḥaddiŝ."}]}