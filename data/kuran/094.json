{"no":94,"ayetler":[{"n":1,"g":6091,"c":30,"s":596,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tr":"Senin gönlünü açmadık mı?","ok":"elem neşraḥ leke ṣadrak."},{"n":2,"g":6092,"c":30,"s":596,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tr":"Belini büken yükünü üzerinden almadık mı?","ok":"veveḍa`nâ `anke vizrak."},{"n":3,"g":6093,"c":30,"s":596,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tr":"Belini büken yükünü üzerinden almadık mı?","ok":"elleẕî enḳaḍa żahrak."},{"n":4,"g":6094,"c":30,"s":596,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tr":"Senin şanını yükseltmedik mi?","ok":"verafa`nâ leke ẕikrak."},{"n":5,"g":6095,"c":30,"s":596,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tr":"Elbette güçlükle beraber şüphesiz bir kolaylık vardır.","ok":"feinne me`a-l`usri yüsrâ."},{"n":6,"g":6096,"c":30,"s":596,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","tr":"Gerçekten, güçlükle beraber bir kolaylık vardır.","ok":"inne me`a-l`usri yüsrâ."},{"n":7,"g":6097,"c":30,"s":596,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tr":"Öyleyse, bir işi bitirince diğerine giriş;","ok":"feiẕâ feragte fenṣab."},{"n":8,"g":6098,"c":30,"s":596,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tr":"Ve ümit edeceğini yalnız Rabbinden iste.","ok":"veilâ rabbike fergab."}]}