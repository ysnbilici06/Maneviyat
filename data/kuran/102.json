{"no":102,"ayetler":[{"n":1,"g":6169,"c":30,"s":600,"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","tr":"Çoğunluk olmak iddianız sizi o kadar meşgul etti ki, mezarları ziyaretle oradakileri de sayacak kadar oldunuz.","ok":"elhâkümü-ttekâŝür."},{"n":2,"g":6170,"c":30,"s":600,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","tr":"Çoğunluk olmak iddianız sizi o kadar meşgul etti ki, mezarları ziyaretle oradakileri de sayacak kadar oldunuz.","ok":"ḥattâ zürtümü-lmeḳâbir."},{"n":3,"g":6171,"c":30,"s":600,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","tr":"Hayır; öyle olmayın; yakında bileceksiniz.","ok":"kellâ sevfe ta`lemûn."},{"n":4,"g":6172,"c":30,"s":600,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","tr":"Hayır; gözünüzü açın; yakında bileceksiniz.","ok":"ŝümme kellâ sevfe ta`lemûn."},{"n":5,"g":6173,"c":30,"s":600,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","tr":"Dikkat edin, şayet yaptığınızın sonucunu kesin olarak bir bilseniz!","ok":"kellâ lev ta`lemûne `ilme-lyeḳîn."},{"n":6,"g":6174,"c":30,"s":600,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","tr":"And olsun ki, cehennemi göreceksiniz.","ok":"leteravunne-lceḥîm."},{"n":7,"g":6175,"c":30,"s":600,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","tr":"And olsun ki, onu gözünüzle kesin olarak göreceksiniz.","ok":"ŝümme leteravunnehâ `ayne-lyeḳîn."},{"n":8,"g":6176,"c":30,"s":600,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","tr":"Sonra o gün, size verilmiş olan her nimetten sorguya çekileceksiniz.","ok":"ŝümme letüs'elünne yevmeiẕin `ani-nne`îm."}]}