{"no":109,"ayetler":[{"n":1,"g":6208,"c":30,"s":603,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tr":"De ki: \"Ey inkarcılar!\"","ok":"ḳul yâ eyyühe-lkâfirûn."},{"n":2,"g":6209,"c":30,"s":603,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"\"Ben sizin taptıklarınıza tapmam.\"","ok":"lâ a`büdü mâ ta`büdûn."},{"n":3,"g":6210,"c":30,"s":603,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"\"Benim taptığıma da sizler tapmazsınız.\"","ok":"velâ entüm `âbidûne mâ a`büd."},{"n":4,"g":6211,"c":30,"s":603,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","tr":"\"Ben de sizin taptığınıza tapacak değilim.\"","ok":"velâ ene `âbidüm mâ `abettüm."},{"n":5,"g":6212,"c":30,"s":603,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"\"Benim taptığıma da sizler tapmıyorsunuz.\"","ok":"velâ entüm `âbidûne mâ a`büd."},{"n":6,"g":6213,"c":30,"s":603,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"\"Sizin dininiz size, benim dinim banadır.\"","ok":"leküm dînüküm veliye dîn."}]}