{"no":112,"ayetler":[{"n":1,"g":6222,"c":30,"s":604,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","tr":"De ki: O Allah bir tektir.","ok":"ḳul hüve-llâhü eḥad."},{"n":2,"g":6223,"c":30,"s":604,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allah her şeyden müstağni ve her şey O'na muhtaçtır.","ok":"allâhu-ṣṣamed."},{"n":3,"g":6224,"c":30,"s":604,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tr":"O doğurmamış ve doğmamıştır.","ok":"lem yelid velem yûled."},{"n":4,"g":6225,"c":30,"s":604,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tr":"Hiçbir şey O'na denk değildir.","ok":"velem yekül lehû küfüven eḥad."}]}